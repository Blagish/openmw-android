From 606f4b8179a15d2ffb1b3ca94239c48a7736ac38 Mon Sep 17 00:00:00 2001
From: blagish <sir.blagish@gmail.com>
Date: Fri, 6 Nov 2026 17:48:29 +0400
Subject: [PATCH] Speed up saving by writing ESM records in one go

---
 components/esm3/esmwriter.cpp | 52 ++++++++++++++---------------------
 components/esm3/esmwriter.hpp | 14 ++++++----
 2 files changed, 29 insertions(+), 37 deletions(-)

diff --git a/components/esm3/esmwriter.cpp b/components/esm3/esmwriter.cpp
index 3820137685..92bf1891af 100644
--- a/components/esm3/esmwriter.cpp
+++ b/components/esm3/esmwriter.cpp
@@ -1,6 +1,7 @@
 #include "esmwriter.hpp"
 
 #include <cassert>
+#include <cstring>
 #include <fstream>
 #include <stdexcept>
 
@@ -77,7 +78,6 @@ namespace ESM
         , mHeaderPos()
         , mEncoder(nullptr)
         , mRecordCount(0)
-        , mCounting(true)
         , mHeader()
     {
     }
@@ -134,7 +134,7 @@ namespace ESM
     {
         mRecordCount = 0;
         mRecords.clear();
-        mCounting = true;
+        mBuffer.clear();
         mStream = &file;
 
         startRecord("TES3", 0);
@@ -154,17 +154,13 @@ namespace ESM
     {
         mRecordCount++;
 
+        // Opened before the header is written: without an open record write() goes straight to the stream.
+        const std::size_t sizeOffset = mBuffer.size() + NAME::sCapacity;
+        mRecords.push_back({ name, sizeOffset, sizeOffset + 3 * sizeof(uint32_t) });
         writeName(name);
-        RecordData rec;
-        rec.name = name;
-        rec.position = mStream->tellp();
-        rec.size = 0;
         writeT<uint32_t>(0); // Size goes here
         writeT<uint32_t>(0); // Unused header?
         writeT(flags);
-        mRecords.push_back(rec);
-
-        assert(mRecords.back().size == 0);
     }
 
     void ESMWriter::startRecord(uint32_t name, uint32_t flags)
@@ -177,30 +173,27 @@ namespace ESM
         // Sub-record hierarchies are not properly supported in ESMReader. This should be fixed later.
         assert(mRecords.size() <= 1);
 
+        // Opened before the header is written, as in startRecord.
+        const std::size_t sizeOffset = mBuffer.size() + NAME::sCapacity;
+        mRecords.push_back({ name, sizeOffset, sizeOffset + sizeof(uint32_t) });
         writeName(name);
-        RecordData rec;
-        rec.name = name;
-        rec.position = mStream->tellp();
-        rec.size = 0;
         writeT<uint32_t>(0); // Size goes here
-        mRecords.push_back(rec);
-
-        assert(mRecords.back().size == 0);
     }
 
     void ESMWriter::endRecord(NAME name)
     {
-        RecordData rec = mRecords.back();
-        assert(rec.name == name);
+        const RecordData rec = mRecords.back();
+        assert(rec.mName == name);
         mRecords.pop_back();
 
-        mStream->seekp(rec.position);
-
-        mCounting = false;
-        write(reinterpret_cast<const char*>(&rec.size), sizeof(uint32_t));
-        mCounting = true;
+        const uint32_t size = static_cast<uint32_t>(mBuffer.size() - rec.mDataOffset);
+        std::memcpy(mBuffer.data() + rec.mSizeOffset, &size, sizeof(size));
 
-        mStream->seekp(0, std::ios::end);
+        if (mRecords.empty())
+        {
+            mStream->write(mBuffer.data(), static_cast<std::streamsize>(mBuffer.size()));
+            mBuffer.clear();
+        }
     }
 
     void ESMWriter::endRecord(uint32_t name)
@@ -331,13 +324,10 @@ namespace ESM
 
     void ESMWriter::write(const char* data, size_t size)
     {
-        if (mCounting && !mRecords.empty())
-        {
-            for (std::list<RecordData>::iterator it = mRecords.begin(); it != mRecords.end(); ++it)
-                it->size += static_cast<uint32_t>(size);
-        }
-
-        mStream->write(data, size);
+        if (mRecords.empty())
+            mStream->write(data, size);
+        else
+            mBuffer.append(data, size);
     }
 
     void ESMWriter::writeFormId(const FormId& formId, bool wide, NAME tag)
diff --git a/components/esm3/esmwriter.hpp b/components/esm3/esmwriter.hpp
index 96445bcdae..fb64cff6ea 100644
--- a/components/esm3/esmwriter.hpp
+++ b/components/esm3/esmwriter.hpp
@@ -2,8 +2,9 @@
 #define OPENMW_ESM_WRITER_H
 
 #include <iosfwd>
-#include <list>
+#include <string>
 #include <type_traits>
+#include <vector>
 
 #include "components/esm/decompose.hpp"
 #include "components/esm/esmcommon.hpp"
@@ -23,9 +24,9 @@ namespace ESM
     {
         struct RecordData
         {
-            NAME name;
-            std::streampos position;
-            uint32_t size;
+            NAME mName;
+            std::size_t mSizeOffset;
+            std::size_t mDataOffset;
         };
 
     public:
@@ -198,12 +199,13 @@ namespace ESM
         void writeFormId(const ESM::FormId&, bool wide = false, NAME tag = "FRMR");
 
     private:
-        std::list<RecordData> mRecords;
+        std::vector<RecordData> mRecords;
+        // Bytes of the outermost open record; endRecord fills in sizes here and writes the record out when it ends.
+        std::string mBuffer;
         std::ostream* mStream;
         std::streampos mHeaderPos;
         ToUTF8::Utf8Encoder* mEncoder;
         int mRecordCount;
-        bool mCounting;
 
         Header mHeader;
 
-- 
2.56.0

